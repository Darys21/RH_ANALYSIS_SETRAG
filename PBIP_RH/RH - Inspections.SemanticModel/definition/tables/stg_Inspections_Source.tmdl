	column ID_Inspection
		dataType: int64
		formatString: 0
		lineageTag: c0f04685-a28f-4d4d-8b4b-1c1477c96be2
		summarizeBy: none
		sourceColumn: ID_Inspection

		annotation SummarizationSetBy = Automatic

	partition stg_Inspections_Source = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(
				        File.Contents(
				            "C:\Users\jyd.anguilet\OneDrive - Eramet SA\Indicateurs Infrastructures Sociales - INDICATEURS\Recap Inspections IS.xlsx"
				        ),
				        null,
				        false
				    ),
				
				    RECAP = Source{[Item = "RECAP", Kind = "Sheet"]}[Data],
				
				    LignesSource = Table.ToRows(RECAP),
				
				    PositionEntete = List.PositionOf(
				        List.Transform(
				            LignesSource,
				            each
				                List.Contains(_, "N°")
				                and List.Contains(_, "Date de réception")
				        ),
				        true
				    ),
				
				    DonneesAvecEntetes =
				        if PositionEntete = -1 then
				            error "Ligne d'entête introuvable dans la feuille RECAP."
				        else
				            Table.PromoteHeaders(
				                Table.Skip(RECAP, PositionEntete),
				                [PromoteAllScalars = true]
				            ),
				
				    LignesNonVides = Table.SelectRows(
				        DonneesAvecEntetes,
				        each
				            List.NonNullCount(
				                List.Transform(
				                    Record.FieldValues(_),
				                    (Valeur) =>
				                        if Valeur is text
				                            and Text.Trim(Valeur) = ""
				                        then null
				                        else Valeur
				                )
				            ) > 0
				    ),
				
				    ColonnesNettoyees = Table.TransformColumns(
				        LignesNonVides,
				        List.Transform(
				            Table.ColumnNames(LignesNonVides),
				            (NomColonne) =>
				                {
				                    NomColonne,
				                    (Valeur) =>
				                        if Valeur is text
				                        then Text.Trim(Valeur)
				                        else Valeur,
				                    type any
				                }
				        )
				    ),
				
				    StatutsNettoyes = Table.TransformColumns(
				        ColonnesNettoyees,
				        {
				            {
				                "Gravité",
				                each
				                    if _ is text
				                    then Text.Proper(Text.Trim(_))
				                    else _,
				                type text
				            }
				        }
				    ),
				
				    QualiteDateReception = Table.AddColumn(
				        StatutsNettoyes,
				        "Qualité date réception",
				        each
				            let
				                DateTest = try Date.From(
				                    [Date de réception],
				                    "fr-FR"
				                ) otherwise null
				            in
				                if DateTest = null
				                    or DateTest = #date(1900, 1, 1)
				                then "À vérifier"
				                else "OK",
				        type text
				    ),
				
				    TypesCorriges = Table.TransformColumns(
				        QualiteDateReception,
				        {
				            {
				                "N°",
				                each try Int64.From(_) otherwise null,
				                Int64.Type
				            },
				            {
				                "Date de réception",
				                each
				                    try Date.From(_, "fr-FR")
				                    otherwise null,
				                type date
				            },
				            {
				                "Date de clôture",
				                each
				                    try Date.From(_, "fr-FR")
				                    otherwise null,
				                type date
				            },
				            {
				                "Taux de réalisation",
				                each try Number.From(_) otherwise null,
				                type number
				            }
				        }
				    ),
				
				    IdentifiantTechnique = Table.AddIndexColumn(
				        TypesCorriges,
				        "ID_Inspection",
				        1,
				        1,
				        Int64.Type
				    )
				
				in
				    IdentifiantTechnique

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

