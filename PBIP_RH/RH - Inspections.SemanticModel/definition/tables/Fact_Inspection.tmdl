table Fact_Inspection
	lineageTag: 2f176e11-dc8e-46f1-bb36-6a2c6b4a7c69

	measure 'Nombre d''anomalies' = COUNTROWS(Fact_Inspection)
		formatString: 0
		lineageTag: e5c1c1b0-acf7-47dc-97a5-c1fcfe0e746c

	measure 'Stock en attente' = CALCULATE([Nombre d'anomalies], Fact_Inspection[Etat_Pilotage] = "En attente")
		formatString: 0
		lineageTag: a405ba0b-2227-4ece-a9d9-e5ee3abaed73

	measure 'Anomalies en cours' = CALCULATE([Nombre d'anomalies], Fact_Inspection[Etat_Pilotage] = "En cours")
		formatString: 0
		lineageTag: 63292849-6d91-493e-b507-37bceef54c2d

	measure 'Clôtures confirmées' = CALCULATE([Nombre d'anomalies], Fact_Inspection[Etat_Pilotage] = "Clôture confirmée")
		formatString: 0
		lineageTag: 9b2f601c-ffc1-4e3c-a42f-24f13df58697

	measure 'Clôtures à vérifier' = CALCULATE([Nombre d'anomalies], Fact_Inspection[Etat_Pilotage] = "Clôture à vérifier")
		formatString: 0
		lineageTag: 215ee91d-557b-440b-a3a4-2963789a89d8

	measure 'Taux de clôture confirmée' = DIVIDE([Clôtures confirmées], [Nombre d'anomalies], 0)
		formatString: 0.0%
		lineageTag: 712fd2d6-510f-4c2e-aa4d-4e10186d3c9e

	measure 'Délai moyen de clôture (jours)' = AVERAGE(Fact_Inspection[Délai clôture (jours)])
		formatString: #,##0.0
		lineageTag: c40c005a-cab8-4aaa-882e-c8871fbcf41f

	measure 'Stock ouvert' = [Stock en attente] + [Anomalies en cours]
		formatString: 0
		lineageTag: b044387a-89df-4ac5-9e7d-7acffa1de442

	measure 'Anomalies en attente > 30 jours' =
			CALCULATE(
			    [Nombre d'anomalies],
			    Fact_Inspection[Etat_Pilotage] = "En attente",
			    FILTER(
			        Fact_Inspection,
			        NOT ISBLANK(Fact_Inspection[Date réception valide])
			            && Fact_Inspection[Date réception valide] < TODAY() - 30
			    )
			)
		formatString: 0
		lineageTag: 9f3446b0-753b-48e3-8fba-ba2cf952d8be

	measure 'Écarts à traiter' =
			CALCULATE (
			    [Nombre d'anomalies],
			    NOT (
			        CONTAINSSTRING ( LOWER ( COALESCE ( Fact_Inspection[Nom de l'écart], "" ) ), "r.a.s" )
			            || CONTAINSSTRING ( LOWER ( COALESCE ( Fact_Inspection[Nom de l'écart], "" ) ), "visite" )
			            || CONTAINSSTRING ( LOWER ( COALESCE ( Fact_Inspection[Nom de l'écart], "" ) ), "inspection réalisée" )
			            || CONTAINSSTRING ( LOWER ( COALESCE ( Fact_Inspection[Nom de l'écart], "" ) ), "pas d'écart" )
			            || CONTAINSSTRING ( LOWER ( COALESCE ( Fact_Inspection[Nom de l'écart], "" ) ), "aucun nouvel" )
			            || Fact_Inspection[Famille action] = "RAS / Positif"
			    )
			)
		formatString: 0
		lineageTag: b1b1b1b1-c2c2-d3d3-e4e4-f5f5f5f5f5f5

	measure 'Anomalies gravité forte' =
			CALCULATE ( [Nombre d'anomalies], Fact_Inspection[Gravité] = "Forte" )
		formatString: 0
		lineageTag: e4e4e4e4-f5f5-a6a6-b7b7-c8c8c8c8c8c8

	measure 'Délai max de clôture (jours)' = MAX ( Fact_Inspection[Délai clôture (jours)] )
		formatString: 0
		lineageTag: f5f5f5f5-a6a6-b7b7-c8c8-d9d9d9d9d9d9

