table Fact_Inspection
	lineageTag: 2f176e11-dc8e-46f1-bb36-6a2c6b4a7c69

	measure 'Nombre d''anomalies' = ```
			COUNTROWS(Fact_Inspection)
			
			```
		formatString: 0
		lineageTag: e5c1c1b0-acf7-47dc-97a5-c1fcfe0e746c

	measure 'Stock en attente' = ```
			CALCULATE([Nombre d'anomalies], Fact_Inspection[Etat_Pilotage] = "En attente")
			
			```
		formatString: 0
		lineageTag: a405ba0b-2227-4ece-a9d9-e5ee3abaed73

	measure 'Anomalies en cours' = ```
			CALCULATE([Nombre d'anomalies], Fact_Inspection[Etat_Pilotage] = "En cours")
			
			```
		formatString: 0
		lineageTag: 63292849-6d91-493e-b507-37bceef54c2d

	measure 'Clôtures confirmées' = ```
			CALCULATE([Nombre d'anomalies], Fact_Inspection[Etat_Pilotage] = "Clôture confirmée")
			
			```
		formatString: 0
		lineageTag: 9b2f601c-ffc1-4e3c-a42f-24f13df58697

	measure 'Clôtures à vérifier' = ```
			CALCULATE([Nombre d'anomalies], Fact_Inspection[Etat_Pilotage] = "Clôture à vérifier")
			
			```
		formatString: 0
		lineageTag: 215ee91d-557b-440b-a3a4-2963789a89d8

	measure 'Taux de clôture confirmée' = DIVIDE([Clôtures confirmées], [Nombre d'anomalies], 0)
		formatString: 0.0%
		lineageTag: 712fd2d6-510f-4c2e-aa4d-4e10186d3c9e

	measure 'Délai moyen de clôture (jours)' = AVERAGE(Fact_Inspection[Délai clôture (jours)])
		formatString: #,##0.0
		lineageTag: c40c005a-cab8-4aaa-882e-c8871fbcf41f

	measure 'Stock ouvert' =
			
			[Stock en attente] + [Anomalies en cours]
		formatString: 0
		lineageTag: b044387a-89df-4ac5-9e7d-7acffa1de442

	measure 'Part du stock en attente' =
			DIVIDE(
			    [Stock en attente],
			    [Nombre d'anomalies],
			    0
			)
		formatString: 0.0%
		lineageTag: 140d614f-621d-42a0-8ce8-68610a20ea98

	measure 'Taux de clôture à vérifier' =
			DIVIDE(
			    [Clôtures à vérifier],
			    [Nombre d'anomalies],
			    0
			)
		formatString: 0.0%
		lineageTag: b00b929e-e0d2-40b5-a83a-5be11aabf664

	measure 'Ancienneté moyenne du stock (jours)' =
			CALCULATE(
			    AVERAGEX(
			        Fact_Inspection,
			        DATEDIFF(
			            Fact_Inspection[Date réception valide],
			            TODAY(),
			            DAY
			        )
			    ),
			    Fact_Inspection[Etat_Pilotage] = "En attente",
			    Fact_Inspection[Date réception valide] <> BLANK()
			)
		formatString: #,##0.0
		lineageTag: 71d635e8-aefc-48a3-9a41-9eed9800598f

	measure 'Anomalies en attente > 30 jours' =
			
			CALCULATE(
			    [Nombre d'anomalies],
			    Fact_Inspection[Etat_Pilotage] = "En attente",
			    FILTER(
			        Fact_Inspection,
			        NOT ISBLANK(Fact_Inspection[Date réception valide])
			            && Fact_Inspection[Date réception valide] < TODAY() - 30
			    )
			)
		formatString: 0
		lineageTag: 9f3446b0-753b-48e3-8fba-ba2cf952d8be

	measure 'Délai médian de clôture (jours)' = MEDIAN(Fact_Inspection[Délai clôture (jours)])
		formatString: #,##0.0
		lineageTag: 0f5ea6ca-baac-4ea1-8009-b120dc81fad1

	measure 'Dates de réception à vérifier' =
			
			CALCULATE(
			    [Nombre d'anomalies],
			    Fact_Inspection[Qualité date réception] = "À vérifier"
			)
		formatString: 0
		lineageTag: 6530c9f1-7083-45f3-90bf-9da13e997e5e

	measure 'Dates de clôture absentes' =
			
			CALCULATE(
			    [Nombre d'anomalies],
			    Fact_Inspection[Qualité date clôture] = "Absente"
			)
		formatString: 0
		lineageTag: acae3d39-40ac-410e-857d-228b878e41d3

	measure 'Écarts à traiter' = CALCULATE ( [Nombre d'anomalies], Fact_Inspection[Type_Ecart] = "Écart à traiter" )
		formatString: 0
		lineageTag: b1b1b1b1-c2c2-d3d3-e4e4-f5f5f5f5f5f5

	measure 'RAS / Suivi' = CALCULATE ( [Nombre d'anomalies], Fact_Inspection[Type_Ecart] = "RAS / Suivi" )
		formatString: 0
		lineageTag: c2c2c2c2-d3d3-e4e4-f5f5-a6a6a6a6a6a6

	measure 'Taux de traitement' =
			DIVIDE (
			    [Clôtures confirmées] + [Clôtures à vérifier],
			    [Écarts à traiter],
			    0
			)
		formatString: 0.0%
		lineageTag: d3d3d3d3-e4e4-f5f5-a6a6-b7b7b7b7b7b7

	measure 'Anomalies gravité forte' = CALCULATE ( [Nombre d'anomalies], Fact_Inspection[Gravité] = "Forte" )
		formatString: 0
		lineageTag: e4e4e4e4-f5f5-a6a6-b7b7-c8c8c8c8c8c8

	measure 'Délai max de clôture (jours)' = MAX ( Fact_Inspection[Délai clôture (jours)] )
		formatString: 0
		lineageTag: f5f5f5f5-a6a6-b7b7-c8c8-d9d9d9d9d9d9

